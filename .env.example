# Perplexity API
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Notion API
NOTION_API_KEY=your_notion_api_key_here
NOTION_RESEARCH_DATABASE_ID=your_research_database_id
NOTION_VENTURES_DATABASE_ID=your_ventures_database_id
NOTION_PROJECTS_DATABASE_ID=your_projects_database_id

# Google Drive API
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_default_folder_id

# Email Notification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# Slack Notification
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# WhatsApp Notification (optional)
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_API_URL=https://api.fonnte.com/send

# Obsidian Vault
OBSIDIAN_VAULT_PATH=/path/to/your/EAT-Knowledge-Vault

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/research.log

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=10
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5
